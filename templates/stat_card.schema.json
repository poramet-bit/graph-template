{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatCardTemplate",
  "type": "object",
  "required": ["type", "label", "value"],
  "properties": {
    "type": { "const": "stat_card" },
    "label": { "type": "string" },
    "value": { "type": "number" },
    "format": { "type": "string", "enum": ["number", "currency", "percent"] },
    "icon": { "type": "string" },
    "status": { "type": "string", "enum": ["good", "warning", "critical", "neutral"] },
    "trend": {
      "type": "object",
      "required": ["direction", "label"],
      "properties": {
        "direction": { "type": "string", "enum": ["up", "down", "flat"] },
        "value": { "type": "number" },
        "label": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source_query": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
