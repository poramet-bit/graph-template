{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GaugeChartTemplate",
  "type": "object",
  "required": ["type", "title", "value", "min", "max"],
  "properties": {
    "type": { "const": "gauge" },
    "title": { "type": "string" },
    "value": { "type": "number" },
    "min": { "type": "number" },
    "max": { "type": "number" },
    "unit": { "type": "string" },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "color"],
        "properties": {
          "from": { "type": "number" },
          "to": { "type": "number" },
          "color": { "type": "string", "enum": ["good", "warning", "critical"] }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source_query": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
